# Only what this workspace uses and no library brings. Everything else (OSGi API, Jakarta API,
# Felix SCR/ConfigAdmin/Configurator, Jersey, Jackson, slf4j, EMF, the codec, M2X, the test
# libraries) comes from the repositories of the bnd libraries below.

# The bnd libraries (see -library in fennec.bnd)
org.eclipse.fennec.bnd:org.eclipse.fennec.bnd.library:0.0.9
org.eclipse.fennec.bnd:org.eclipse.fennec.jacoco.bnd.library:0.0.9
org.eclipse.fennec.bnd:org.eclipse.fennec.osgitest.bnd.library:0.0.9
org.eclipse.fennec.emf:org.eclipse.fennec.emf.osgi.bnd.library.workspace:1.1.0-SNAPSHOT
org.eclipse.fennec.codec:org.eclipse.fennec.codec.workspace.library:0.1.0-SNAPSHOT
org.eclipse.fennec.m2x:org.eclipse.fennec.m2x.library.workspace:0.1.1-SNAPSHOT
org.eclipse.osgi-technology.rest:org.eclipse.osgitech.rest.bnd.library:1.2.3

# OpenAPI importer of emf.util: links the path operations of an OpenAPI document to the
# EClasses the codec generates from its schemas
org.eclipse.fennec.util:org.eclipse.fennec.openapi.ecore:1.0.0-SNAPSHOT
org.eclipse.fennec.util:org.eclipse.fennec.service.api:1.0.0-SNAPSHOT

# Runtime DTOs of the Jakarta RS whiteboard, read by the OSGi tests
org.osgi:org.osgi.dto:1.1.1

# Framework and HTTP server of the bndruns; the classic spifly bundle instead of the framework
# extension the libraries bring (see -runblacklist in the bndruns)
org.apache.felix:org.apache.felix.framework:7.0.5
org.apache.felix:org.apache.felix.http.jetty12:1.0.34
org.apache.aries.spifly:org.apache.aries.spifly.dynamic.bundle:1.3.8

# ASM for spifly 1.3.8, which reads Java 25 class files (the libraries bring 9.6)
org.ow2.asm:asm:9.10.1
org.ow2.asm:asm-analysis:9.10.1
org.ow2.asm:asm-commons:9.10.1
org.ow2.asm:asm-tree:9.10.1
org.ow2.asm:asm-util:9.10.1
