Bundle-Name: Fennec Modelled REST - OpenAPI via QVT-O
Bundle-Description: The derivation of a modelled application from an OpenAPI document as a \
 QVT-O transformation (OpenApiToRest.qvto), run with the Fennec M2X engine. It does what \
 org.eclipse.fennec.rest.openapi does in Java and is tested against it.

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.rest.model;version=project,\
	org.eclipse.fennec.rest.openapi;version=project,\
	org.eclipse.fennec.openapi.ecore;version=latest,\
	org.eclipse.fennec.service.api;version=latest,\
	org.eclipse.fennec.openapi.model;version=latest,\
	org.eclipse.fennec.codec.jsonschema.model;version=latest,\
	org.eclipse.fennec.m2x.qvto.api;version=latest,\
	org.eclipse.fennec.m2x.qvto.engine;version=latest,\
	org.eclipse.fennec.m2x.qvto.model;version=latest,\
	org.eclipse.fennec.m2x.qvt.model;version=latest,\
	org.eclipse.fennec.m2x.qvtd.api;version=latest,\
	org.eclipse.fennec.m2x.unit;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest

# Standalone class path of the QVT-O engine (see its user guide) plus the codec pipeline that
# loads the OpenAPI document.
-testpath: \
	org.eclipse.fennec.m2x.qvto.parser;version=latest,\
	org.eclipse.fennec.m2x.qvtd.api;version=latest,\
	org.eclipse.fennec.m2x.unit;version=latest,\
	org.eclipse.fennec.m2x.ocl.parser;version=latest,\
	org.eclipse.fennec.m2x.ocl.engine;version=latest,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec.openapi;version=latest,\
	org.eclipse.fennec.codec.jsonschema;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest
