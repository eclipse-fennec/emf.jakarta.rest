<?xml version="1.0" encoding="UTF-8"?>
<rest:RestApplication xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:rest="https://eclipse.org/fennec/rest/1.0.0"
    name="greeting" basePath="greeting">
  <resources path="greetings">
    <target href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService"/>
    <methods httpMethod="GET" path="{name}">
      <operation href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/greet"/>
      <produces>text/plain</produces>
      <parameters source="PATH">
        <parameter href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/greet/name"/>
      </parameters>
      <parameters source="QUERY" name="n" defaultValue="1">
        <parameter href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/greet/times"/>
      </parameters>
    </methods>
    <methods httpMethod="POST" path="shout">
      <operation href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/shout"/>
      <consumes>text/plain</consumes>
      <produces>text/plain</produces>
      <parameters source="BODY">
        <parameter href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/shout/text"/>
      </parameters>
    </methods>
    <methods httpMethod="GET" path="{name}/details">
      <operation href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/describe"/>
      <produces>application/json</produces>
      <parameters source="PATH">
        <parameter href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/describe/name"/>
      </parameters>
    </methods>
    <methods httpMethod="POST" path="reply">
      <operation href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/reply"/>
      <consumes>application/json</consumes>
      <produces>application/json</produces>
      <parameters source="BODY">
        <parameter href="https://eclipse.org/fennec/rest/example/greeting/1.0#//GreetingService/reply/greeting"/>
      </parameters>
    </methods>
  </resources>
</rest:RestApplication>
