-runfw: org.apache.felix.framework
-runee: JavaSE-21

# SBOM for `./gradlew sbom`: the exporter is included only once it has been fetched (see
# cnf/sbom/plugin.bnd); resolve, the build and the tests ignore both lines.
-include: ${if;${isfile;${workspace}/cnf/cache/sbom-exporter/org.gecko.bnd.sbom.jar};${workspace}/cnf/sbom/plugin.bnd}
-sbom: level=medium, format=cyclonedx

-resolve.effective: active

# The bundles of the modelled REST runtime plus what is wired only by DS and configuration and
# would not be pulled in by capability resolution alone: the codec that reads and writes EObject
# bodies, the EMF runtime with the dynamic package loader, and the Jakarta RS whiteboard.
-runrequires: \
	bnd.identity;id='org.eclipse.fennec.rest.model',\
	bnd.identity;id='org.eclipse.fennec.rest',\
	bnd.identity;id='org.eclipse.fennec.rest.openapi',\
	bnd.identity;id='org.eclipse.fennec.codec.rest',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.osgitech.rest',\
	bnd.identity;id='org.eclipse.osgitech.rest.servlet.whiteboard'

# The spifly framework-extension variant breaks weaving at startup (it embeds an older ASM).
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.23.0,2.23.1)',\
	jakarta.activation-api;version='[2.1.2,2.1.3)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.0,4.0.1)',\
	javassist;version='[3.29.2,3.29.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.8,1.3.9)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.http.jetty12;version='[1.0.34,1.0.35)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.apache.felix.scr;version='[2.3.0,2.3.1)',\
	org.eclipse.emf.common;version='[2.46.0,2.46.1)',\
	org.eclipse.emf.ecore;version='[2.43.0,2.43.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.41.0,2.41.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.jsonschema;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.jsonschema.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.openapi;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.rest;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.yaml;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.openapi.ecore;version='[1.0.0,1.0.1)',\
	org.eclipse.fennec.openapi.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.rest;version=snapshot,\
	org.eclipse.fennec.rest.model;version=snapshot,\
	org.eclipse.fennec.rest.openapi;version=snapshot,\
	org.eclipse.fennec.service.api;version='[1.0.0,1.0.1)',\
	org.eclipse.osgitech.rest;version='[1.2.3,1.2.4)',\
	org.eclipse.osgitech.rest.servlet.whiteboard;version='[1.2.3,1.2.4)',\
	org.eclipse.osgitech.rest.sse;version='[1.2.3,1.2.4)',\
	org.glassfish.hk2.api;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.external.aopalliance-repackaged;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.locator;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.osgi-resource-locator;version='[1.0.3,1.0.4)',\
	org.glassfish.hk2.utils;version='[3.0.5,3.0.6)',\
	org.glassfish.jersey.containers.jersey-container-servlet;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.containers.jersey-container-servlet-core;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-client;version='[3.1.3,3.1.4)',\
